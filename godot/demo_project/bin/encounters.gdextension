[configuration]
entry_symbol = "encounters_library_init"
compatibility_minimum = "4.2"

[libraries]
macos.debug     = "res://bin/libencounters.macos.template_debug.framework"
macos.release   = "res://bin/libencounters.macos.template_release.framework"
windows.debug.x86_64   = "res://bin/libencounters.windows.template_debug.x86_64.dll"
windows.release.x86_64  = "res://bin/libencounters.windows.template_release.x86_64.dll"
linux.debug.x86_64   = "res://bin/libencounters.linux.template_debug.x86_64.so"
linux.release.x86_64  = "res://bin/libencounters.linux.template_release.x86_64.so"
