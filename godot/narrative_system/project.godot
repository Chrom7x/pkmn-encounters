; Proyecto Godot 4 mínimo para diálogos + cinemáticas + tienda/mercado.
; Ábrelo con Godot 4.3+ o copia autoload/ + scripts/ + data/ a tu proyecto y
; replica esta sección [autoload].

config_version=5

[application]

config/name="Pkmn Fan Game — Diálogos, Cinemáticas y Tienda"
config/features=PackedStringArray("4.3")
run/main_scene=""

[autoload]

; El orden importa: primero los que no dependen de nadie.
EventBus="*res://autoload/event_bus.gd"
Flags="*res://autoload/flags.gd"
ItemDatabase="*res://autoload/item_database.gd"
GameActions="*res://autoload/game_actions.gd"
Inventory="*res://autoload/inventory.gd"
ShopManager="*res://autoload/shop_manager.gd"
DialogueManager="*res://autoload/dialogue_manager.gd"
CutsceneManager="*res://autoload/cutscene_manager.gd"

; Las acciones de entrada "interact" y "cutscene_skip" se crean por código en
; EventBus._ready() si no existen.
